    "position_y": 0.72
  },
  "zoom": {
    "every_s": 0,
    "on_emphasis": true
  },
  "broll": {
    "every_s": 3.5,
    "max_dur_s": 1.6
  },
  "sfx": {
    "density_per_10s": 1.2,
    "map": {
      "hook": "pop",
      "broll": "pop"
    }
