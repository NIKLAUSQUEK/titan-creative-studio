{
  "name": "map-explainer",
  "label": "Map/archival explainer (Johnny Harris / Vox-style)",
  "kind": "pro",
  "description": "Host on camera + paper textures, archival, map zooms, serif type; cold-open question, chapters, twist, synthesis.",
  "structure": {
    "name": "map-explainer",
    "target_s": [
      60,
      600
    ],
    "beats": [
      "cold-open question 0-15s",
      "title sting",
      "context chapters",
      "twist / scale escalation",
      "synthesis + CTA"
    ]
  },
  "pacing": {
    "remove_silence_over_s": 0.4,
    "pad_s": 0.1,
    "max_shot_s": 6.0
  },
  "captions": {
    "max_words": 4,
    "position_y": 0.82,
    "uppercase": false,
    "highlight": "#F2C14E",
    "animation": "pop",
    "font": "DejaVu Serif"
  },
  "zoom": {
    "every_s": 6,
    "scale": 1.08,
    "mode": "smooth"
  },
  "broll": {
    "every_s": 4.0,
    "max_dur_s": 8.0
  },
  "sfx": {
    "density_per_10s": 3,
    "map": {
      "hook": "riser",
      "zoom": "whoosh",
      "broll": "click",
      "title": "impact",
      "end": "ding"
    }
  },
  "music": {
    "energy": "low",
    "db": -20
  },
  "grade": {
    "contrast": 1.05,
    "saturation": 0.9,
    "warmth": 0.05,
    "vignette": true
  },
  "hook_text": {
    "max_words": 7,
    "position_y": 0.2,
    "dur_s": 3.0,
    "uppercase": false,
    "enabled": true
  },
  "aspect": "16:9 (9:16 shorts cut)",
  "sync": {
    "broll": "maps, archival, documents, data graphics on every place/date/number; 50-70%",
    "fillers": "paper/texture transitions, map zoom-throughs, pops on labels",
    "music": "low curious bed (plucks/marimba) under setup, tension pulse at the twist, resolve under synthesis",
    "emotion_map": "curiosity → understanding → surprise (twist) → insight",
    "transitions": "map zoom-throughs, texture wipes, J-cuts into chapters"
  },
  "brands": [
    "TITAN.AI",
    "Klaus personal",
    "Physio Spot deep dives"
  ],
  "funnel": [
    "TOFU",
    "MOFU"
  ],
  "references": [
    "research/sources-style-library.md#johnny-harris-vox"
  ],
  "evidence": "est. from public sources; calibrate with measured references",
  "boards": {
    "auto": true,
    "mode": "full",
    "max": 6
  }
}