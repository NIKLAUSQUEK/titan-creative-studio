{
  "name": "sea-skit",
  "label": "SEA skit (Singlish / Malay comedy)",
  "kind": "niche",
  "description": "Localised one-person or couple skit: situation text on top, in-character open, escalation, music stops dead on the punchline, reaction tag.",
  "structure": {
    "name": "sea-skit",
    "target_s": [
      15,
      45
    ],
