      "setup",
      "escalation",
      "twist / punchline (music stops)",
      "reaction tag"
    ]
  },
  "pacing": {
    "remove_silence_over_s": 0.3,
    "pad_s": 0.1,
    "max_shot_s": 3.0,
    "remove_fillers": "none"
  },
  "captions": {
    "max_words": 7,
    "position_y": 0.74,
    "uppercase": false,
    "highlight": "#FFFFFF",
    "animation": "static",
    "emoji": true
  },
  "zoom": {
    "every_s": 0,
    "on_emphasis": true,
    "scale": 1.2,
    "mode": "snap"
  },
  "broll": {
    "every_s": 0,
    "max_dur_s": 0
  },
  "sfx": {
