{
  "name": "ugc-day-in-the-life",
  "label": "UGC: day in the life",
  "kind": "ugc",
  "description": "Timestamped vignettes (6:00 AM, 9:30 AM \u2026) as lower-thirds, 1-3 s shots, VO or captions, warm natural grade, steady music bed.",
  "structure": {
    "name": "ditl",
    "target_s": [
      20,
      60
    ],
    "beats": [
      "hook: the unusual part of the day 0-2s",
      "morning",
      "work moment",
      "the real/unglamorous bit",
      "evening/lesson",
      "CTA"
    ]
  },
  "pacing": {
    "remove_silence_over_s": 0.4,
    "max_shot_s": 3
  },
  "captions": {
    "max_words": 5,
    "animation": "static",
    "keyword_caps": false
  },
  "zoom": {
    "every_s": 0
  },
  "broll": {
    "every_s": 2.5,
    "max_dur_s": 2.5
  },
  "sfx": {
    "density_per_10s": 0.5
  },
  "music": {
    "energy": "mid",
    "db": -18
  },
  "grade": {
    "warmth": 0.03
  }
}