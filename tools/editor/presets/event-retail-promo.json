{
  "name": "event-retail-promo",
  "label": "Event / retail / mall opening (music-only walk-in)",
  "kind": "genre",
  "description": "Measured 2026-10-25 (POP MART MOA, New Balance The Grove): storefront at 0 s, 1 s beat-cut inserts (hero product -> hands on activation -> freebie -> shelf walk), bag-out or what-where-when card held >=2 s. No subtitles; info lives on one card + caption.",
  "reference": "research/genre-research-2026-10/luxury-retail-transform-asmr.md#28",
  "beat_sync": true,
  "structure": {
    "name": "walk-in",
    "target_s": [
      10,
      25
    ],
    "beats": [
      "storefront 0-1s",
      "hero product",
      "hands on activation",
      "freebie / photo moment",
      "shelf walk",
      "bag-out or what-where-when 2s+"
    ]
  },
  "pacing": {
    "remove_silence_over_s": 0.3,
    "pad_s": 0.03,
    "max_shot_s": 3.2
  },
  "captions": {
    "enabled": false
  },
  "hook_text": {
    "enabled": true,
    "renderer": "card",
    "card_style": "box",
    "persistent": false,
    "dur_s": 1.6,
    "position_y": 0.22,
    "uppercase": false,
    "max_words": 6
  },
  "zoom": {
    "mode": "snap",
    "every_s": 0,
    "on_hook": 1.0
  },
  "transitions": {
    "default": "flash",
    "on": "beats",
    "dur_s": 0.06,
    "strength": 0.25
  },
  "sfx": {
    "density_per_10s": 0.5,
    "db": -14,
    "map": {
      "title": "pop",
      "end": "ding"
    }
  },
  "music": {
    "energy": "high",
    "db": -10,
    "duck": false
  },
  "grade": {
    "contrast": 1.05,
    "saturation": 1.12,
    "brightness": 0.02
  },
  "broll": {
    "every_s": 1.0,
    "max_dur_s": 1.3,
    "min_dur_s": 0.5,
    "mode": "full"
  },
  "end_card": {
    "enabled": true,
    "dur_s": 2.2,
    "_needs_feature": "end_card.fields {date, place, unit, hours} rendered as a what-where-when card"
  }
}
