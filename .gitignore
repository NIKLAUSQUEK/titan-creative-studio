.studio/allow_once
**/outputs/*.mp4
**/qc_out/
.env

# Creator Brain media stays in Drive (never commit photos/videos of people)
brain/**/*.jpg
brain/**/*.jpeg
brain/**/*.png
brain/**/*.heic
brain/**/*.mov
brain/**/*.mp4
brain/**/*.m4a

# Auto-editor: renders, QC images and the selftest project stay local (recipes, briefs and ingest JSON are the record)
__pycache__/
projects/_selftest/
projects/*/autoedit/renders/
projects/*/autoedit/qc/
projects/*/autoedit/ingest/**/*.jpg
projects/*/autoedit/broll_sheet.jpg

# Media library: photos of people and machine-specific indexes stay on the PC (never commit faces)
assets/models/
assets/people/**/*.jpg
assets/people/**/*.jpeg
assets/people/**/*.png
assets/people/**/*.heic
assets/people/**/*.webp
assets/people/**/*.mp4
assets/people/**/*.mov
assets/library/**/*.jpg
assets/library/**/*.jpeg
assets/library/**/*.png
assets/library/**/*.webp
assets/library/index.csv
